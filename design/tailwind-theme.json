{
  "$schema": "https://tailwindcss.com/docs/theme",
  "_meta": {
    "name": "Fillo Bakes Design System",
    "version": "1.0.0",
    "target": "Tailwind CSS v4 (@theme) — see _usage",
    "source": "design/DESIGN.md · design/tokens.css",
    "provenance": "Primary #023d5d and cream #fffde8 sampled from assets/logo/fillo-logo-transparent.png. Paper, ink, kiln, crumb and category values derived from sampled pixels in moodboard/*.webp (see design/moodboard-analysis.md).",
    "_usage": {
      "v4": "Import design/tokens.css first, then paste the `theme` block below into an `@theme { ... }` at-rule in your global stylesheet, converting each key to its CSS custom property name (e.g. colors.paper.50 -> --color-paper-50, fontSize.display-2xl -> --text-display-2xl, spacing.6 -> --spacing-6). Values already reference the tokens.css variables where a single source of truth matters.",
      "v3": "Drop the `theme` block into `theme.extend` in tailwind.config.ts and import design/tokens.css in your global stylesheet so the var() references resolve."
    }
  },

  "theme": {
    "colors": {
      "navy": "var(--color-navy)",
      "logocream": "var(--color-logo-cream)",

      "paper": {
        "0": "var(--color-paper-0)",
        "50": "var(--color-paper-50)",
        "100": "var(--color-paper-100)",
        "200": "var(--color-paper-200)",
        "300": "var(--color-paper-300)",
        "400": "var(--color-paper-400)"
      },

      "ink": {
        "400": "var(--color-ink-400)",
        "500": "var(--color-ink-500)",
        "600": "var(--color-ink-600)",
        "700": "var(--color-ink-700)",
        "800": "var(--color-ink-800)",
        "900": "var(--color-ink-900)"
      },

      "kiln": {
        "DEFAULT": "var(--color-kiln)",
        "100": "var(--color-kiln-100)",
        "700": "var(--color-kiln-700)"
      },

      "crumb": {
        "DEFAULT": "var(--color-crumb)",
        "ink": "var(--color-crumb-ink)"
      },

      "success": {
        "DEFAULT": "var(--color-success)",
        "tint": "var(--color-success-tint)"
      },
      "warning": {
        "DEFAULT": "var(--color-warning)",
        "tint": "var(--color-warning-tint)"
      },
      "danger": {
        "DEFAULT": "var(--color-danger)",
        "tint": "var(--color-danger-tint)"
      },
      "info": {
        "DEFAULT": "var(--color-info)",
        "tint": "var(--color-info-tint)"
      },

      "cat": {
        "breads": "var(--cat-breads)",
        "breads-ink": "var(--cat-breads-ink)",
        "anpan": "var(--cat-anpan)",
        "anpan-ink": "var(--cat-anpan-ink)",
        "karepan": "var(--cat-karepan)",
        "karepan-ink": "var(--cat-karepan-ink)",
        "pies": "var(--cat-pies)",
        "pies-ink": "var(--cat-pies-ink)",
        "sandos": "var(--cat-sandos)",
        "sandos-ink": "var(--cat-sandos-ink)",
        "weekly": "var(--cat-weekly)",
        "weekly-ink": "var(--cat-weekly-ink)"
      },

      "scrim": "var(--color-scrim)",
      "veil": "var(--color-veil)"
    },

    "fontFamily": {
      "display": ["Instrument Serif", "Iowan Old Style", "Palatino Linotype", "Georgia", "serif"],
      "sans": ["Hanken Grotesk", "ui-sans-serif", "-apple-system", "Segoe UI", "Helvetica", "Arial", "sans-serif"],
      "mono": ["DM Mono", "ui-monospace", "SF Mono", "Menlo", "Consolas", "monospace"],
      "kana": ["Zen Kaku Gothic New", "Hiragino Sans", "Yu Gothic", "Noto Sans JP", "sans-serif"]
    },

    "fontSize": {
      "display-2xl": ["var(--text-display-2xl)", { "lineHeight": "0.88", "letterSpacing": "-0.02em", "fontWeight": "400" }],
      "display-xl": ["var(--text-display-xl)", { "lineHeight": "0.92", "letterSpacing": "-0.018em", "fontWeight": "400" }],
      "display-lg": ["var(--text-display-lg)", { "lineHeight": "0.98", "letterSpacing": "-0.015em", "fontWeight": "400" }],
      "display-md": ["var(--text-display-md)", { "lineHeight": "1.06", "letterSpacing": "-0.01em", "fontWeight": "400" }],
      "display-sm": ["var(--text-display-sm)", { "lineHeight": "1.14", "letterSpacing": "-0.005em", "fontWeight": "400" }],
      "title-lg": ["var(--text-title-lg)", { "lineHeight": "1.28", "letterSpacing": "-0.005em", "fontWeight": "600" }],
      "title": ["var(--text-title)", { "lineHeight": "1.35", "letterSpacing": "0em", "fontWeight": "600" }],
      "body-lg": ["var(--text-body-lg)", { "lineHeight": "1.62", "letterSpacing": "0em" }],
      "body": ["var(--text-body)", { "lineHeight": "1.6", "letterSpacing": "0em" }],
      "body-sm": ["var(--text-body-sm)", { "lineHeight": "1.55", "letterSpacing": "0em" }],
      "caption": ["var(--text-caption)", { "lineHeight": "1.45", "letterSpacing": "0.005em" }],
      "micro": ["var(--text-micro)", { "lineHeight": "1.3", "letterSpacing": "0.12em" }],
      "nano": ["var(--text-nano)", { "lineHeight": "1.2", "letterSpacing": "0.16em" }]
    },

    "fontWeight": {
      "display": "400",
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },

    "letterSpacing": {
      "display-2xl": "-0.02em",
      "display-xl": "-0.018em",
      "display-lg": "-0.015em",
      "display-md": "-0.01em",
      "display-sm": "-0.005em",
      "normal": "0em",
      "caption": "0.005em",
      "kana": "0.06em",
      "micro": "0.12em",
      "nano": "0.16em"
    },

    "lineHeight": {
      "display-2xl": "0.88",
      "display-xl": "0.92",
      "display-lg": "0.98",
      "display-md": "1.06",
      "display-sm": "1.14",
      "title-lg": "1.28",
      "title": "1.35",
      "body-lg": "1.62",
      "body": "1.6",
      "body-sm": "1.55",
      "caption": "1.45",
      "micro": "1.3",
      "nano": "1.2"
    },

    "spacing": {
      "0": "0",
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.25rem",
      "6": "1.5rem",
      "8": "2rem",
      "10": "2.5rem",
      "12": "3rem",
      "16": "4rem",
      "20": "5rem",
      "24": "6rem",
      "32": "8rem",
      "40": "10rem",
      "48": "12rem",
      "section": "var(--section-y)",
      "section-lg": "var(--section-y-lg)",
      "gutter": "var(--gutter)",
      "header": "var(--header-h)",
      "header-scrolled": "var(--header-h-scrolled)",
      "announcement": "var(--announcement-h)"
    },

    "borderRadius": {
      "none": "0",
      "xs": "2px",
      "sm": "4px",
      "md": "8px",
      "lg": "12px",
      "xl": "16px",
      "pill": "999px",
      "blob": "58% 42% 55% 45% / 48% 55% 45% 52%"
    },

    "borderWidth": {
      "hairline": "1px",
      "strong": "1.5px"
    },

    "borderColor": {
      "hairline": "var(--color-paper-300)",
      "hairline-strong": "var(--color-paper-400)",
      "hairline-dark": "rgba(255, 253, 232, 0.14)",
      "input": "var(--color-paper-400)",
      "input-focus": "var(--color-ink-800)",
      "strong": "var(--color-ink-800)"
    },

    "boxShadow": {
      "none": "none",
      "contact": "0 18px 24px -18px rgba(4, 33, 47, 0.35)",
      "lift": "0 2px 4px -2px rgba(4, 33, 47, 0.06), 0 12px 28px -12px rgba(4, 33, 47, 0.16)",
      "overlay": "0 24px 60px -20px rgba(4, 33, 47, 0.3)",
      "sticky": "0 1px 0 0 var(--color-paper-300)"
    },

    "maxWidth": {
      "content": "var(--max-content)",
      "narrow": "var(--max-narrow)",
      "prose": "var(--max-prose)",
      "lead": "46ch"
    },

    "screens": {
      "sm": "480px",
      "md": "768px",
      "lg": "1024px",
      "xl": "1280px",
      "2xl": "1536px"
    },

    "transitionDuration": {
      "instant": "0ms",
      "fast": "140ms",
      "base": "220ms",
      "slow": "380ms",
      "slower": "640ms"
    },

    "transitionTimingFunction": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "in": "cubic-bezier(0.7, 0, 0.84, 0)",
      "inout": "cubic-bezier(0.65, 0, 0.35, 1)"
    },

    "animation": {
      "marquee": "fillo-marquee var(--dur-marquee) linear infinite",
      "seal": "fillo-seal var(--dur-seal) linear infinite",
      "pulse-van": "fillo-pulse 1.8s linear infinite",
      "reveal": "fillo-reveal var(--dur-slower) cubic-bezier(0.16, 1, 0.3, 1) both",
      "shimmer": "fillo-shimmer 1.4s linear infinite"
    },

    "keyframes": {
      "fillo-marquee": {
        "from": { "transform": "translateX(0)" },
        "to": { "transform": "translateX(-50%)" }
      },
      "fillo-seal": {
        "from": { "transform": "rotate(0deg)" },
        "to": { "transform": "rotate(360deg)" }
      },
      "fillo-pulse": {
        "0%": { "transform": "scale(1)", "opacity": "0.5" },
        "100%": { "transform": "scale(2.4)", "opacity": "0" }
      },
      "fillo-reveal": {
        "from": { "opacity": "0", "transform": "translateY(16px)" },
        "to": { "opacity": "1", "transform": "none" }
      },
      "fillo-shimmer": {
        "from": { "backgroundPosition": "-200% 0" },
        "to": { "backgroundPosition": "200% 0" }
      }
    },

    "zIndex": {
      "base": "0",
      "sticky": "50",
      "tracker": "60",
      "drawer": "70",
      "dialog": "80",
      "toast": "90"
    },

    "height": {
      "control-sm": "36px",
      "control-md": "44px",
      "control-lg": "52px",
      "input": "48px",
      "hit": "44px"
    },

    "aspectRatio": {
      "product": "1 / 1",
      "hero": "16 / 9",
      "hero-mobile": "4 / 5",
      "story": "3 / 2",
      "map-widget": "16 / 10",
      "map-page": "4 / 3",
      "door": "4 / 3"
    },

    "gap": {
      "grid": "var(--grid-gap)",
      "product-grid": "var(--product-grid-gap)",
      "stagger": "60ms"
    }
  },

  "_rules": {
    "contrast": {
      "body": "ink-600 on paper-50 = 6.49:1 (AA + AAA normal text)",
      "smallest": "ink-500 on paper-50 = 4.98:1 (AA)",
      "onWells": "text on paper-200 steps up to ink-600 (5.44:1); ink-500 there is 3.41:1 and fails",
      "forbidden": [
        "kiln on ink-900 = 2.46:1 — use crumb (7.45:1) on dark instead",
        "crumb on paper = 2.09:1 — fill only; use crumb-ink (5.12:1) for text",
        "ink-400 as text on paper = 2.42:1 — non-text only (legal on ink-900 at 6.43:1)",
        "cat.breads as text = 2.20:1 — use cat.breads-ink (4.87:1)"
      ]
    },
    "usage": {
      "primaryButton": "bg-ink-800 text-paper-0 (11.29:1); hover ink-700; active ink-900",
      "accent": "kiln is the kicker/seal/ticker/badge accent — never the primary CTA fill",
      "signal": "crumb is limited to: van pulse, baked-today stamp, Fillo+ coins, star ratings, the dark-band marquee rule",
      "category": "hint only — a 2px underline, a 5px dot, or an active filter chip. Never a card, tile or button fill",
      "radiusBlob": "seal/stamp, van marker, hero image mask, testimonial avatar — nowhere else",
      "shadow": "default is none. contact = product cutouts only. lift = card hover only. overlay = drawer/dialog/toast only",
      "displayWeight": "always 400 — set headlines larger, never bolder",
      "focus": "2px solid kiln, offset 2px, :focus-visible only; crumb on dark surfaces",
      "hitTarget": "44x44px minimum on every interactive element"
    },
    "banned": [
      "#FFFFFF and #000000 as surfaces",
      "#1B3A5F (the live site's incorrect navy) and #F8F4E3",
      "Tailwind default palette colours (yellow-400, slate-*, gray-*, etc.)",
      "a sm/md/lg/xl shadow ramp",
      "gradient button fills, glassmorphism, purple anything",
      "emoji in the UI, filled icon sets, stroke widths other than 1.5",
      "display type below 24px or body sans above 24px",
      "countdown timers and fabricated stock or ETA numbers",
      "Japanese outside the kana slot; Kannada anywhere in the chrome"
    ]
  }
}
